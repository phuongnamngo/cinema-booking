# ---- Postgres ----
POSTGRES_DB=cinema_booking
POSTGRES_USER=cinema_booking
POSTGRES_PASSWORD=change-me
# Ký tự đặc biệt trong mật khẩu PHẢI được percent-encode trong DATABASE_URL (@ -> %40, ! -> %21, ...)
DATABASE_URL=postgres://cinema_booking:change-me@db:5432/cinema_booking
DB_CONN_MAX_AGE=0

# ---- Redis: 0 = giữ ghế + channel layer, 1 = Celery, 2 = cache/throttling ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CACHE_URL=redis://redis:6379/2

# ---- Django ----
# Sinh bằng: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Tránh ký tự $ trong giá trị (Docker Compose coi $ là nội suy biến)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
# Production: tên miền thật, nhớ thêm localhost cho health check nội bộ
# ALLOWED_HOSTS=cinema.example.com,localhost
# CSRF_TRUSTED_ORIGINS=https://cinema.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Số reverse proxy đáng tin phía trước Django (dev: 0, sau Nginx: 1)
NUM_PROXIES=0
# ENABLE_API_DOCS=0
# HSTS_SECONDS=3600
# HSTS_INCLUDE_SUBDOMAINS=0

# ---- Logging / Sentry ----
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# APP_VERSION=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Thanh toán ----
# Sinh bằng: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PAYMENT_WEBHOOK_SECRET=
